# ========================================================
# Git Ignore for Odin Projects on Windows
# ========================================================

# Build output directories & executables
bin/
build/
out/
dist/
*.exe
*.bin
*.out

# Shared & static libraries
*.dll
*.so
*.dylib
*.lib
*.a

# Debug / MSVC / Clang intermediary & symbol files
*.pdb
*.ilk
*.obj
*.o
*.idb
*.dSYM/
*.suo
*.user

# Odin compiler cache & profiling
*.spall
*.dmp
*.trace

# Editor & IDE files
.vs/
.idea/
*.sublime-project
*.sublime-workspace
.fleet/

# VS Code (preserve useful workspace tasks & settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS specific files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary files & logs
*.log
*.tmp
*.bak
*~
.env
.env.*
!.env.example
