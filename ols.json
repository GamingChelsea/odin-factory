{
	"$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
	"odin_command": "R:/odin/odin.exe",
	"collections": [
		{
			"name": "core",
			"path": "R:/odin/core"
		},
		{
			"name": "vendor",
			"path": "R:/odin/vendor"
		}
	],
	"profile": "default",
	"profiles": [
		{
			"name": "default",
			"checker_path": ["src"]
		}
	],
	"enable_format": true,
	"enable_hover": true,
	"enable_hover_layout": true,
	"enable_document_symbols": true,
	"enable_semantic_tokens": true,
	"enable_snippets": true,
	"enable_procedure_context": true,
	"enable_inlay_hints_params": true,
	"enable_inlay_hints_default_params": true,
	"enable_inlay_hints_implicit_return": true,
	"enable_auto_import": true,
	"enable_references": true,
	"enable_document_highlights": true,
	"enable_completions": true,
	"enable_completion_matching": true,
	"enable_diagnostics": true,
	"enable_parser_errors": true
}
